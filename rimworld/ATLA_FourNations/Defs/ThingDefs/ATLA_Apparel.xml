      <color>(170, 30, 25)</color>
    </graphicData>
    <costList>
      <Cloth>50</Cloth>
      <Steel>15</Steel>
    </costList>
    <statBases>
      <WorkToMake>8000</WorkToMake>
      <MaxHitPoints>200</MaxHitPoints>
      <Mass>2.2</Mass>
      <Flammability>0.4</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
      <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
      <ArmorRating_Heat>0.35</ArmorRating_Heat>
      <Insulation_Cold>14</Insulation_Cold>
      <Insulation_Heat>6</Insulation_Heat>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Jacket/Jacket</wornGraphicPath>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>ATLA_FireNation</li>
      </tags>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="ATLA_ApparelBase">
    <defName>ATLA_EarthKingdomGarb</defName>
    <label>Earth Kingdom garb</label>
    <description>Sturdy green and tan clothes in the style of Ba Sing Se. Made for long days working stone.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/TribalA/TribalA</texPath>
      <color>(75, 125, 60)</color>
    </graphicData>
    <costList>
      <Cloth>60</Cloth>
    </costList>
    <statBases>
      <WorkToMake>5000</WorkToMake>
      <MaxHitPoints>160</MaxHitPoints>
      <Mass>1.5</Mass>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
      <ArmorRating_Sharp>0.08</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.14</ArmorRating_Blunt>
      <Insulation_Cold>12</Insulation_Cold>
      <Insulation_Heat>8</Insulation_Heat>
    </statBases>
    <equippedStatOffsets>
      <MiningSpeed>0.1</MiningSpeed>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/TribalA/TribalA</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>ATLA_EarthKingdom</li>
      </tags>
    </apparel>
  </ThingDef>

</Defs>
