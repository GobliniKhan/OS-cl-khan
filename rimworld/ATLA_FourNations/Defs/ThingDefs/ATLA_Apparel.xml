    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Parka/Parka</texPath>
      <color>(50, 105, 190)</color>
    </graphicData>
    <costList>
      <Cloth>40</Cloth>
      <Leather_Plain>40</Leather_Plain>
    </costList>
    <statBases>
      <WorkToMake>8000</WorkToMake>
      <MaxHitPoints>180</MaxHitPoints>
      <Mass>2.5</Mass>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
      <ArmorRating_Sharp>0.12</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      <Insulation_Cold>60</Insulation_Cold>
      <Insulation_Heat>-6</Insulation_Heat>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Parka/Parka</wornGraphicPath>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>ATLA_WaterTribe</li>
      </tags>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="ATLA_ApparelBase">
