<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef>
    <defName>ATLA_SpiritWater</defName>
    <label>Spirit Oasis water</label>
    <description>Water drawn from the Spirit Oasis of the North Pole and blessed by a waterbending healer. Drinking it eases pain, slows bleeding and speeds recovery from disease for about half a day.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>Item</altitudeLayer>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <alwaysHaulable>true</alwaysHaulable>
    <rotatable>false</rotatable>
    <pathCost>14</pathCost>
    <stackLimit>25</stackLimit>
    <tickerType>Never</tickerType>
    <techLevel>Medieval</techLevel>
    <socialPropernessMatters>false</socialPropernessMatters>
    <graphicData>
      <texPath>ATLA/Items/SpiritWater</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <thingCategories>
      <li>Drugs</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>45</MarketValue>
      <Mass>0.2</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
      <WorkToMake>900</WorkToMake>
    </statBases>
    <costList>
      <MedicineHerbal>1</MedicineHerbal>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Medicine</workSkill>
      <recipeUsers>
        <li>CraftingSpot</li>
        <li>DrugLab</li>
      </recipeUsers>
      <researchPrerequisite>ATLA_AdvancedBending</researchPrerequisite>
      <bulkRecipeCount>4</bulkRecipeCount>
    </recipeMaker>
    <ingestible>
      <foodType>Fluid, Processed</foodType>
      <preferability>NeverForNutrition</preferability>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <baseIngestTicks>100</baseIngestTicks>
      <chairSearchRadius>0</chairSearchRadius>
      <ingestSound>Ingest_Beer</ingestSound>
      <drugCategory>Medical</drugCategory>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>ATLA_SpiritWaterBlessing</hediffDef>
          <severity>1.0</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Drug">
        <listOrder>1000</listOrder>
        <overdoseSeverityOffset>0</overdoseSeverityOffset>
      </li>
    </comps>
  </ThingDef>

</Defs>
